#!/bin/sh /etc/rc.common

START=96
STOP=9
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/linkup-cloudflared-quick
	procd_set_param user cftunnel
	procd_set_param group cftunnel
	procd_set_param respawn 3600 5 5
	procd_set_param limits core="0"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger network
}
