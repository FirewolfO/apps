#!/bin/sh

set -u

CLOUDFLARED_BIN="${CLOUDFLARED_BIN:-/usr/bin/cloudflared}"
PUBLISH_BIN="${PUBLISH_BIN:-/usr/libexec/linkup-dynv6-publish-txt}"
LOG_FILE="${LOG_FILE:-/tmp/cloudflared-quick-im.log}"
STATE_DIR="${STATE_DIR:-/tmp/cloudflared-quick}"
STATE_FILE="$STATE_DIR/im.url"
POLL_INTERVAL="${POLL_INTERVAL:-2}"

umask 077
mkdir -p "$STATE_DIR"
: >"$LOG_FILE"

child_pid=""
stop_child() {
	if [ -n "$child_pid" ]; then
		kill "$child_pid" 2>/dev/null || true
		wait "$child_pid" 2>/dev/null || true
	fi
	exit 0
}
trap stop_child INT TERM

"$CLOUDFLARED_BIN" tunnel \
	--no-autoupdate \
	--protocol http2 \
	--logfile "$LOG_FILE" \
	--url http://127.0.0.1:3000 &
child_pid=$!
published_url=""

while kill -0 "$child_pid" 2>/dev/null; do
	url="$(sed -n 's#.*\(https://[a-z0-9-]*\.trycloudflare\.com\).*#\1#p' "$LOG_FILE" | tail -1)"
	if [ -n "$url" ] && [ "$url" != "$published_url" ]; then
		if "$PUBLISH_BIN" "$url"; then
			printf '%s\n' "$url" >"$STATE_FILE"
			published_url="$url"
		fi
	fi
	sleep "$POLL_INTERVAL"
done

wait "$child_pid"
exit $?
