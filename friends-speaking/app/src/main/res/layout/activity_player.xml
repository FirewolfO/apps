<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/cream" />

        <TextView
            android:id="@+id/episode_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cream"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/import_audio"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_secondary"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="音频"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="12sp" />

        <Button
            android:id="@+id/import_subtitle"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_secondary"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="字幕"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/media_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/muted"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_subtitle">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subtitle_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/subtitle_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="正在加载双语台词…"
            android:textColor="@color/muted"
            android:textSize="16sp" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/current_time"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="00:00"
            android:textColor="@color/cream"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/playback_seek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/duration_time"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="--:--"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/previous_line"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="上一句"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="12sp" />

        <Button
            android:id="@+id/play_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="播放"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/replay_line"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="重听"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="12sp" />

        <Button
            android:id="@+id/next_line"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="下一句"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="12sp" />

        <Button
            android:id="@+id/playback_speed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="1x"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
